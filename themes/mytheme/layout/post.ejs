<article class="post-detail">
  <div class="container container-narrow">
    <header class="post-header">
      <h1 class="post-header-title"><%= page.title %></h1>
      <div class="post-header-meta">
        <span class="date"><%= date(page.date, 'YYYY-MM-DD') %></span>
        <% if (page.categories && page.categories.length) { %>
          <% page.categories.forEach(cat => { %>
            <a href="<%- url_for(cat.path) %>" class="category"><%= cat.name %></a>
          <% }) %>
        <% } %>
      </div>
      <% if (page.tags && page.tags.length) { %>
        <div class="post-header-tags">
          <% page.tags.forEach(tag => { %>
            <a href="<%- url_for(tag.path) %>" class="tag">#<%= tag.name %></a>
          <% }) %>
        </div>
      <% } %>
    </header>
    <div class="post-content">
      <%- page.content %>
    </div>
    <div class="post-nav">
      <a href="/" class="btn-back">&larr; 返回首页</a>
    </div>
  </div>
</article>
