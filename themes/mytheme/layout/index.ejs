<section class="hero">
  <div class="container">
    <h1 class="hero-title"><%= config.title %></h1>
    <p class="hero-subtitle"><%= config.subtitle %></p>
  </div>
</section>

<section class="posts-section">
  <div class="container">
    <div class="posts-grid">
      <% page.posts.forEach(post => { %>
        <article class="post-card">
          <div class="post-card-inner">
            <div class="post-card-top">
              <span class="post-date"><%= date(post.date, 'YYYY-MM-DD') %></span>
              <% if (post.categories && post.categories.length) { %>
                <% post.categories.forEach(cat => { %>
                  <span class="post-category"><%= cat.name %></span>
                <% }) %>
              <% } %>
            </div>
            <h2 class="post-title">
              <a href="<%- url_for(post.path) %>"><%= post.title %></a>
            </h2>
            <p class="post-excerpt"><%- strip_html(post.excerpt || post.content).substring(0, 120) %>...</p>
            <div class="post-card-bottom">
              <% if (post.tags && post.tags.length) { %>
                <div class="post-tags">
                  <% post.tags.forEach(tag => { %>
                    <a href="<%- url_for(tag.path) %>" class="tag">#<%= tag.name %></a>
                  <% }) %>
                </div>
              <% } %>
              <a href="<%- url_for(post.path) %>" class="read-more">阅读全文 &rarr;</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>

    <% if (page.total > 1) { %>
      <div class="pagination">
        <%- paginator({prev_text: '&laquo; 上一页', next_text: '下一页 &raquo;'}) %>
      </div>
    <% } %>
  </div>
</section>
